+ * they restate the brief and would mark it outdated the moment it is saved.
  */
+function fingerprint(notes: readonly CaseNoteRecord[], checklist: readonly ChecklistItemRecord[]): string {
+  const noteKey = notes
+    .filter((n) => !n.is_ai_generated)
+    .map((n) => `${n.id}:${n.body}`)
+    .sort();
+  const checklistKey = checklist
+    .map((c) => `${c.id}:${c.status}:${String(c.received_on ?? '')}`)
+    .sort();
+  return JSON.stringify([noteKey, checklistKey]);
+}
+
+function noteText(brief: CaseBrief): string {
+  const lines = [brief.summary];
+  if (brief.needsAttention.length > 0) {
+    lines.push('', 'Needs attention:', ...brief.needsAttention.map((a) => `- ${a.issue}`));
+  }
+  lines.push('', `Next step: ${brief.nextStep}`);
+  return lines.join('\n').slice(0, FIELD_LIMITS.noteBody);
+}
+
+function taskTitle(nextStep: string): string {
+  const max = FIELD_LIMITS.taskTitle;
+  return nextStep.length <= max ? nextStep : `${nextStep.slice(0, max - 1)}…`;
+}
+
+type Saved = 'note' | 'task';
+
 export function BriefPanel({
+  caseId,
+  notes,
+  notesReady,
   checklist,
   checklistReady,
+  onSaveNote,
+  onCreateTask,
 }: {
+  caseId: string;
+  notes: readonly CaseNoteRecord[];
+  notesReady: boolean;
   checklist: readonly ChecklistItemRecord[];
   checklistReady: boolean;
+  /** Stores the reviewed brief as an AI-generated note; rejects on failure. */
+  onSaveNote: (body: string) => Promise<void>;
+  /** Creates a task from the next step; rejects on failure. */
+  onCreateTask: (title: string) => Promise<void>;
 }) {
+  const [brief, setBrief] = useState<{ value: CaseBrief; basis: string } | null>(null);
+  const [generating, setGenerating] = useState(false);
+  const [generateError, setGenerateError] = useState<string | null>(null);
+  const [reviewed, setReviewed] = useState(false);
+  const [saving, setSaving] = useState<Saved | null>(null);
+  const [saved, setSaved] = useState<Set<Saved>>(new Set());
+  const [saveError, setSaveError] = useState<string | null>(null);
+
+  const ready = notesReady && checklistReady;
+  const current = fingerprint(notes, checklist);
+  const outdated = brief !== null && ready && brief.basis !== current;
+  // Computed in the app from the live checklist; the model never decides this.
   const missing = missingItems(checklist);
 
+  async function generate() {
+    setGenerating(true);
+    setGenerateError(null);
+    setSaveError(null);
+    const basis = current;
+    try {
+      const value = await generateCaseBrief(caseId);
+      setBrief({ value, basis });
+      setReviewed(false);
+      setSaved(new Set());
+    } catch (error) {
+      setGenerateError(describeError(error));
+    } finally {
+      setGenerating(false);
+    }
+  }
+
+  async function save(kind: Saved) {
+    if (!brief) return;
+    setSaving(kind);
+    setSaveError(null);
+    try {
+      if (kind === 'note') await onSaveNote(noteText(brief.value));
+      else await onCreateTask(taskTitle(brief.value.nextStep));
+      setSaved((prev) => new Set(prev).add(kind));
+    } catch (error) {
+      setSaveError(describeError(error));
+    } finally {
+      setSaving(null);
+    }
+  }
+
+  const noteById = new Map(notes.map((n) => [n.id, n]));
+
