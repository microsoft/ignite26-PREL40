+/** Reads a query's outcome: a table, or the loading and error states to render instead. */
+function useTable(query: string): { table?: SuccessTable; pending: boolean; error?: string; retry: () => void } {
+  const { data, isLoading, error, refetch } = useSemanticModelQuery({ connection: PORTFOLIO_CONNECTION, query });
+  const retry = () => void refetch();
+  if (error) return { pending: false, error: error.message, retry };
+  if (data?.status === 'error') return { pending: false, error: data.error.message, retry };
+  if (isLoading) return { pending: true, retry };
+  if (data?.status === 'success') return { table: data.table, pending: false, retry };
+  return { pending: !data, retry };
