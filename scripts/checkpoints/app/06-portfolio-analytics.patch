@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  NO_FILTERS,
+  daxString,
+  kpiQuery,
+  stageQuery,
+  stalledCasesQuery,
+  tableRecords,
+} from './portfolio';
+
+const filters = { branch: 'Chicago Loop', product: 'Refinance' };
+
+describe('portfolio queries', () => {
+  it('escapes quotes so a value cannot end the DAX string', () => {
+    expect(daxString('a"b')).toBe('"a""b"');
+  });
+
+  it('applies both filters to every filtered query', () => {
+    for (const query of [kpiQuery(filters), stageQuery(filters), stalledCasesQuery(filters)]) {
+      expect(query).toContain('TREATAS({"Chicago Loop"}, Branch[BranchName])');
+      expect(query).toContain('TREATAS({"Refinance"}, LoanProduct[ProductCategory])');
+    }
+  });
+
+  it('adds no filters when none are chosen', () => {
+    for (const query of [kpiQuery(NO_FILTERS), stageQuery(NO_FILTERS), stalledCasesQuery(NO_FILTERS)]) {
+      expect(query).not.toContain('TREATAS');
+    }
+  });
+
+  it('reads measures from the model instead of computing them', () => {
+    const query = kpiQuery(NO_FILTERS);
+    for (const measure of [
+      '[Open applications]',
+      '[Requested amount in pipeline]',
+      '[Average days in current stage]',
+      '[Stalled applications]',
+    ]) {
+      expect(query).toContain(measure);
+    }
+  });
+
+  it('keys rows by column name', () => {
+    expect(tableRecords({ columns: [{ name: 'a' }, { name: 'b' }], rows: [[1, 2]] })).toEqual([{ a: 1, b: 2 }]);
+  });
+});
diff --git a/packages/frontend/src/queries/portfolio.ts b/packages/frontend/src/queries/portfolio.ts
new file mode 100644
index 0000000..a5053b2
--- /dev/null
+++ b/packages/frontend/src/queries/portfolio.ts
@@ -0,0 +1,92 @@
+import type { ColumnMetadataMap } from '@/lib/to-data-table';
+
+/** Connector name declared in `rayfin/rayfin.yml`. */
+export const PORTFOLIO_CONNECTION = 'caldovaportfolio';
+
+/**
+ * Every number on the portfolio page is a measure the semantic model already
+ * defines. These queries only ask for them; nothing is recalculated in
+ * JavaScript.
+ */
+
+export interface PortfolioFilters {
+  /** `Branch[BranchName]`; empty means all branches. */
+  readonly branch: string;
+  /** `LoanProduct[ProductCategory]`; empty means all products. */
+  readonly product: string;
+}
+
+export const NO_FILTERS: PortfolioFilters = { branch: '', product: '' };
+
+/** A DAX string literal: quotes are doubled, so a value can never end the literal. */
+export function daxString(value: string): string {
+  return `"${value.replace(/"/gu, '""')}"`;
+}
+
+/** Filter arguments shared by every query that honors the page filters. */
+export function filterArguments({ branch, product }: PortfolioFilters): string[] {
+  const filters: string[] = [];
+  if (branch) filters.push(`TREATAS({${daxString(branch)}}, Branch[BranchName])`);
+  if (product) filters.push(`TREATAS({${daxString(product)}}, LoanProduct[ProductCategory])`);
+  return filters;
+}
+
+export const branchOptionsQuery =
+  'EVALUATE FILTER(SUMMARIZECOLUMNS(Branch[BranchName]), NOT ISBLANK(Branch[BranchName])) ORDER BY Branch[BranchName]';
+
+export const productOptionsQuery =
+  'EVALUATE FILTER(SUMMARIZECOLUMNS(LoanProduct[ProductCategory]), NOT ISBLANK(LoanProduct[ProductCategory])) ORDER BY LoanProduct[ProductCategory]';
+
+/** The snapshot date is a property of the data, so it ignores the page filters. */
+export const snapshotQuery = 'EVALUATE ROW("AsOf", MAX(LoanApplication[SnapshotDate]))';
+
+export function kpiQuery(filters: PortfolioFilters): string {
+  const row =
+    'ROW("OpenApplications", [Open applications], ' +
+    '"RequestedAmount", [Requested amount in pipeline], ' +
+    '"AverageDays", [Average days in current stage], ' +
+    '"Stalled", [Stalled applications])';
+  const args = filterArguments(filters);
+  return `EVALUATE ${args.length ? `CALCULATETABLE(${row}, ${args.join(', ')})` : row}`;
+}
+
+export function stageQuery(filters: PortfolioFilters): string {
+  const args = ['LoanApplication[CurrentStage]', ...filterArguments(filters)];
+  return (
+    `EVALUATE SUMMARIZECOLUMNS(${args.join(', ')}, ` +
+    '"Open", [Open applications], "Stalled", [Stalled applications])'
+  );
+}
+
+export function stalledCasesQuery(filters: PortfolioFilters): string {
+  const args = [
+    'LoanApplication[CaseNumber]',
+    'LoanApplication[CurrentStage]',
+    'Branch[BranchName]',
+    'LoanProduct[ProductCategory]',
+    ...filterArguments(filters),
+  ];
+  return (
+    `EVALUATE FILTER(SUMMARIZECOLUMNS(${args.join(', ')}, ` +
+    '"Amount", [Requested amount in pipeline], ' +
+    '"Days", [Average days in current stage], ' +
+    '"Stalled", [Stalled applications]), [Stalled] > 0) ' +
+    'ORDER BY [Days] DESC, LoanApplication[CaseNumber]'
+  );
+}
+
+export const stageColumnMetadata: ColumnMetadataMap = {
+  'LoanApplication[CurrentStage]': { name: 'stage', displayName: 'Stage' },
+  '[Open]': { name: 'open', displayName: 'Open', format: '#,0' },
+  '[Stalled]': { name: 'stalled', displayName: 'Stalled', format: '#,0' },
+};
+
+/** Rows of a query table as objects keyed by the column names the model returned. */
+export function tableRecords(table: {
+  columns: readonly { name: string }[];
+  rows: readonly (readonly unknown[])[];
+}): Record<string, unknown>[] {
+  return table.rows.map((row) =>
+    Object.fromEntries(table.columns.map((column, index) => [column.name, row[index]]))
+  );
+}
