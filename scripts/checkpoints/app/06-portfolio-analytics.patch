+                              Assigned to you
+                            </span>
+                          ) : null}
+                        </div>
+                        <div className="text-200 text-muted-foreground">
+                          {[row.branch, row.product].filter(Boolean).join(' · ')}
+                        </div>
+                      </td>
+                      <td className={cn(td, 'whitespace-nowrap')}>{row.stage}</td>
+                      <td className={cn(td, 'text-right tabular-nums')}>
+                        <span className="inline-flex items-center gap-100 text-warning-foreground">
+                          <AlertCircle aria-hidden="true" className="icon-size-100" />
+                          {row.days ?? '—'}
+                        </span>
+                      </td>
+                      <td className={cn(td, 'whitespace-nowrap text-right tabular-nums')}>
+                        {formatMeasure(row.amount, formatUsd)}
+                      </td>
+                    </tr>
+                  );
+                })}
+              </tbody>
+            </table>
+          </div>
+          <div className="flex items-center justify-between text-200 text-muted-foreground">
+            <span>
+              Showing {Math.min(limit, rows.length)} of {rows.length}
+            </span>
+            {limit < rows.length ? (
+              <button type="button" className={buttonStyles.secondary} onClick={() => setLimit((n) => n + 20)}>
+                Show more
+              </button>
+            ) : null}
+          </div>
+        </>
+      )}
     </Panel>
   );
 }
