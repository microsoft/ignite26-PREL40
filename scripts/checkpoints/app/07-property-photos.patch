new file mode 100644
index 0000000..4f8f8d6
--- /dev/null
+++ b/rayfin/storage/CasePhoto.ts
@@ -0,0 +1,21 @@
+import { role, text, uuid } from '@microsoft/rayfin-core';
+import { ContentTypes, StorageObject, blob, mb } from '@microsoft/rayfin-core/experimental';
+
+/**
+ * Private case files (photos and PDFs). Files can be read, uploaded, and
+ * deleted only when the stored `officer_email` is the signed-in officer's
+ * email claim.
+ */
+@blob({
+  name: 'case-photos',
+  maxSize: mb(5),
+  allowedContentTypes: [ContentTypes.Jpeg, ContentTypes.Png, ContentTypes.Pdf],
+})
+@role('authenticated', ['create', 'read', 'delete'], {
+  policy: (claims, item) => claims.email.eq(item.officer_email),
+})
+export class CasePhoto extends StorageObject {
+  @uuid() case_id!: string;
+  @text({ max: 254 }) officer_email!: string;
+  @text({ max: 60 }) category!: string;
+}
