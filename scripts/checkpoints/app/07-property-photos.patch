@@ -0,0 +1,149 @@
+import { useRef, useState, type FormEvent } from 'react';
+import { Download, FileText } from 'lucide-react';
+
+import { Panel } from '@/components/panel';
+import { buttonStyles } from '@/components/styles';
+import { EmptyState, ErrorState, LoadingState } from '@/components/states';
+import { useAsyncData } from '@/hooks/use-async-data';
+import { formatDateTime } from '@/lib/format';
+import {
+  describeStorageError,
+  displayName,
+  downloadCaseFile,
+  listCaseFiles,
+  uploadCaseFile,
+  validateCaseFile,
+  type CaseFile,
+} from '@/services/case-files';
+
+function formatSize(bytes: number): string {
+  return bytes >= 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;
+}
+
+export function FilesPanel({
+  caseId,
+  requireEmail,
+  onUploaded,
+}: {
+  caseId: string;
+  requireEmail: () => string;
+  /** Runs after a successful upload; a rejection is shown as an error. */
+  onUploaded: () => Promise<void>;
+}) {
+  const files = useAsyncData(() => listCaseFiles(caseId), [caseId]);
+  const input = useRef<HTMLInputElement>(null);
+  const [selected, setSelected] = useState<File | null>(null);
+  const [uploading, setUploading] = useState(false);
+  const [uploadError, setUploadError] = useState<string | null>(null);
+  const [downloading, setDownloading] = useState<string | null>(null);
+  const [downloadError, setDownloadError] = useState<string | null>(null);
+
+  const submit = async (event: FormEvent) => {
+    event.preventDefault();
+    if (!selected) return;
+    setUploadError(null);
+    const problem = validateCaseFile(selected);
+    if (problem) {
+      setUploadError(problem);
+      return;
+    }
+    setUploading(true);
+    try {
+      await uploadCaseFile(caseId, requireEmail(), selected);
+    } catch (error) {
+      setUploadError(describeStorageError(error));
+      setUploading(false);
+      return;
+    }
+    setSelected(null);
+    if (input.current) input.current.value = '';
+    files.reload();
+    try {
+      await onUploaded();
+    } catch (error) {
+      setUploadError(`The file was uploaded, but the checklist wasn't updated: ${describeStorageError(error)}`);
+    } finally {
+      setUploading(false);
+    }
+  };
+
+  const download = async (file: CaseFile) => {
+    setDownloading(file.name);
+    setDownloadError(null);
+    try {
+      const blob = await downloadCaseFile(caseId, file.name);
+      const url = URL.createObjectURL(blob);
+      const link = document.createElement('a');
+      link.href = url;
+      link.download = displayName(file.name);
+      document.body.appendChild(link);
+      link.click();
+      link.remove();
+      URL.revokeObjectURL(url);
+    } catch (error) {
+      setDownloadError(describeStorageError(error));
+    } finally {
+      setDownloading(null);
+    }
+  };
+
+  return (
+    <Panel title="Property files">
+      <form onSubmit={(e) => void submit(e)} className="flex flex-col gap-200">
+        <label htmlFor="case-file" className="text-200 font-medium text-foreground">
+          Renovation plans or current-state photos
+        </label>
+        <input
+          ref={input}
+          id="case-file"
+          type="file"
+          accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf"
+          onChange={(e) => {
+            setSelected(e.target.files?.[0] ?? null);
+            setUploadError(null);
+          }}
+          className="w-full cursor-pointer rounded-lg border border-dashed border-input bg-card p-200 text-200 text-muted-foreground transition-colors hover:border-muted-foreground/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring file:mr-300 file:h-9 file:cursor-pointer file:rounded-lg file:border-0 file:bg-primary file:px-400 file:text-300 file:font-medium file:text-primary-foreground file:shadow-[0_1px_2px_rgb(16_24_40/0.1)] file:transition-colors hover:file:bg-primary/90"
+        />
+        <p className="text-200 text-muted-foreground">JPEG, PNG, or PDF, up to 5 MB.</p>
+        <div className="flex justify-end">
+          <button type="submit" disabled={!selected || uploading} className={buttonStyles.primary}>
+            {uploading ? 'Uploading…' : 'Upload file'}
+          </button>
+        </div>
+      </form>
+
+      {uploadError ? <ErrorState title="Couldn't upload the file" message={uploadError} /> : null}
+      {downloadError ? <ErrorState title="Couldn't download the file" message={downloadError} /> : null}
+      {files.status === 'loading' ? <LoadingState rows={2} label="Loading files" /> : null}
+      {files.status === 'error' ? (
+        <ErrorState title="Couldn't list the files" message={files.error} onRetry={files.reload} />
+      ) : null}
+      {files.status === 'ready' && files.data.length === 0 ? <EmptyState title="No files yet" /> : null}
+      {files.status === 'ready' && files.data.length > 0 ? (
+        <ul className="flex flex-col">
+          {files.data.map((file) => (
+            <li key={file.id} className="flex items-center gap-300 border-t border-border py-300">
+              <FileText aria-hidden="true" className="icon-size-300 shrink-0 text-muted-foreground" />
+              <div className="min-w-0 flex-1">
+                <p className="truncate text-300 font-medium text-foreground">{displayName(file.name)}</p>
+                <p className="text-200 text-muted-foreground">
+                  {formatSize(file.size)}
+                  {file.uploadedAt ? ` · ${formatDateTime(file.uploadedAt)}` : ''}
+                </p>
+              </div>
+              <button
+                type="button"
+                onClick={() => void download(file)}
+                disabled={downloading === file.name}
+                className={buttonStyles.secondary}
+              >
+                <Download aria-hidden="true" className="icon-size-100" />
+                {downloading === file.name ? 'Downloading…' : 'Download'}
+              </button>
+            </li>
+          ))}
+        </ul>
+      ) : null}
+    </Panel>
+  );
+}
