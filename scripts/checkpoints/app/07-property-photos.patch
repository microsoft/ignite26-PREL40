@@ -0,0 +1,121 @@
+import {
+  CASE_FILE_MAX_BYTES,
+  CASE_FILE_TYPES,
+  CASE_PHOTOS_FOLDER,
+  type ChecklistCategory,
+} from '@rayfin-app/shared';
+import { isStorageError } from '@microsoft/rayfin-storage';
+
+import { getRayfinClient } from '@/lib/rayfin-client';
+
+/**
+ * Private property files for a case. Every call runs as the signed-in officer,
+ * so the folder's access rule (`officer_email` must be the caller's email) is
+ * what decides what can be listed, downloaded, uploaded, or deleted. Each
+ * case's files live under their own prefix: its case ID.
+ */
+
+export const PROPERTY_FILES_CATEGORY: ChecklistCategory = 'renovation-plans-photos';
+
+const LIST_LIMIT = 100;
+
+export interface CaseFile {
+  id: string;
+  name: string;
+  size: number;
+  contentType?: string;
+  uploadedAt?: string;
+}
+
+const MIME_BY_EXTENSION: Record<string, (typeof CASE_FILE_TYPES)[number]> = {
+  jpg: 'image/jpeg',
+  jpeg: 'image/jpeg',
+  png: 'image/png',
+  pdf: 'application/pdf',
+};
+
+/** The file's content type if it is JPEG, PNG, or PDF; otherwise `null`. */
+export function allowedContentType(file: Pick<File, 'name' | 'type'>): string | null {
+  const declared = file.type.toLowerCase();
+  if ((CASE_FILE_TYPES as readonly string[]).includes(declared)) return declared;
+  if (declared) return null;
+  const extension = file.name.split('.').pop()?.toLowerCase() ?? '';
+  return MIME_BY_EXTENSION[extension] ?? null;
+}
+
+/** An error message for a file that can't be uploaded, or `null` when it can. */
+export function validateCaseFile(file: File): string | null {
+  if (!allowedContentType(file)) return `${file.name}: only JPEG, PNG, and PDF files can be uploaded.`;
+  if (file.size === 0) return `${file.name}: the file is empty.`;
+  if (file.size > CASE_FILE_MAX_BYTES) return `${file.name}: files can be at most 5 MB.`;
+  return null;
+}
+
+/** A storage-safe, collision-free object name that keeps the original file name readable. */
+export function objectNameFor(fileName: string): string {
+  const safe = fileName
+    .normalize('NFKD')
+    .replace(/[^A-Za-z0-9._-]+/g, '-')
+    .replace(/^[-.]+|-+$/g, '')
+    .slice(-80);
+  return `${crypto.randomUUID().slice(0, 8)}-${safe || 'file'}`;
+}
+
+/** The display name: the object name without its uniqueness prefix. */
+export function displayName(objectName: string): string {
+  return objectName.replace(/^[0-9a-f]{8}-/, '');
+}
+
+/** Storage errors carry a support-friendly code and correlation ID; keep both. */
+export function describeStorageError(error: unknown): string {
+  if (isStorageError(error)) {
+    const detail = error.message || 'The storage request failed.';
+    return `${detail} (${error.code}, ref ${error.correlationId})`;
+  }
+  return error instanceof Error && error.message ? error.message : 'The storage request failed.';
+}
+
+export async function listCaseFiles(caseId: string): Promise<CaseFile[]> {
+  const client = await getRayfinClient();
+  const files: CaseFile[] = [];
+  let continuation: string | undefined;
+  do {
+    const page = await client.storage[CASE_PHOTOS_FOLDER].list({
+      prefix: caseId,
+      limit: LIST_LIMIT,
+      continuation,
+    });
+    for (const item of page.items) {
+      files.push({
+        id: item.id,
+        name: item.name,
+        size: item.size,
+        contentType: item.contentType,
+        uploadedAt: item.createdAt,
+      });
+    }
+    continuation = page.continuation;
+  } while (continuation);
+  return files.sort((a, b) => (b.uploadedAt ?? '').localeCompare(a.uploadedAt ?? ''));
+}
+
+/** Uploads one file for the case, stamped with the case, officer, and category. */
+export async function uploadCaseFile(caseId: string, officerEmail: string, file: File): Promise<void> {
+  const problem = validateCaseFile(file);
+  if (problem) throw new Error(problem);
+  const client = await getRayfinClient();
+  await client.storage[CASE_PHOTOS_FOLDER].upload(objectNameFor(file.name), file, {
+    prefix: caseId,
+    contentType: allowedContentType(file)!,
+    fields: { case_id: caseId, officer_email: officerEmail, category: PROPERTY_FILES_CATEGORY },
+  });
+}
+
+/** Downloads through an authorized, short-lived link and returns the bytes as a Blob. */
+export async function downloadCaseFile(caseId: string, name: string): Promise<Blob> {
+  const client = await getRayfinClient();
+  const result = await client.storage[CASE_PHOTOS_FOLDER].download(name, { prefix: caseId });
+  return new Response(result.stream, {
+    headers: result.contentType ? { 'Content-Type': result.contentType } : undefined,
+  }).blob();
+}
